# 复制为 .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会提交）
SILICONFLOW_API_KEY=sk-你的密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V3
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 服务
HOST=127.0.0.1
PORT=8000

# 分块与检索
CHUNK_STRATEGY=recursive
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
# 结构感知分块：块内注入「文档名 > 章节路径」上下文（提升召回与引用可解释性）
CHUNK_CONTEXT_HEADER=true

# 检索增强开关
RAG_FUSION=true
RERANK_ENABLED=true

# ---------- 文档解析与 OCR（v3.0）----------
OCR_ENABLED=true                # 扫描件/图片是否启用 OCR
OCR_DPI=200                     # PDF 渲染 DPI（越高越清晰但越慢）
OCR_MIN_CONFIDENCE=0.6          # 低于该置信度的识别结果会写入告警
SCANNED_TEXT_PER_PAGE_MIN=50    # 每页字符数低于此值判定为扫描件
SCANNED_IMAGE_RATIO_MAX=0.6     # 图像覆盖占比高于此值判定为扫描件
SCANNED_PROBE_PAGES=5           # 探测前 N 页即可判定
TABLE_MAX_ROWS=300              # 表格最大行数（超出截断并告警）
TABLE_MAX_COLS=15               # 表格最大列数

# ---------- 异步任务 ----------
# 小于该体积且非耗时格式（OCR/图片）时同步处理，保证前端体验
PARSE_SYNC_MAX_BYTES=204800
TASK_WORKERS=2

# ---------- 认证与权限（v3.1）----------
AUTH_ENABLED=true
# 生产环境务必设置（留空则首次启动自动生成并保存到 data/.jwt_secret）
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_DAYS=7
DEFAULT_TENANT=default
# 首次启动自动创建的管理员（请登录后立即修改密码）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
# 权限过滤的召回池：先宽召回再按可见性过滤（越大越安全、越慢）
RETRIEVAL_RECALL_POOL=60

# ---------- 会话与记忆（v3.2）----------
# 工作记忆：每次请求携带的最近对话轮数（1 轮 = 用户+助手各 1 条）
CONTEXT_WINDOW_TURNS=6
# 消息数超过该阈值后触发滚动摘要
SUMMARY_TRIGGER_MESSAGES=12
# 摘要时保留的最近未摘要消息数
SUMMARY_KEEP_RECENT=6
# 摘要文本上限（字符）
SUMMARY_MAX_CHARS=800
# 会话保留天数（超期在启动时清理）
CONVERSATION_TTL_DAYS=180

# ---------- 语义缓存（v3.3）----------
# 缓存键 = 问题向量相似度 + 权限范围指纹 + 索引版本（文档增删自动失效）
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=512
CACHE_TTL_SECONDS=600
# 语义命中阈值（越高越精确、命中率越低）
CACHE_MIN_SIMILARITY=0.97

# ---------- 引用校验（A）----------
# 开启后 /chat 会对答案逐句校验引用，不支持则删句/拒答
CITATION_VERIFY=true
# 参与校验的最大证据条数
CITATION_MAX_EVIDENCE=5
# 冲突检测（B）：开启后 /chat 会检测证据冲突并追加显式归因（每轮多若干次 LLM 调用）
CONFLICT_DETECT=false
